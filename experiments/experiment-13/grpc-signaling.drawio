        <!-- ── Message 5: profile-ca → PIP: ISSUED ──────────────────────── -->
        <mxCell id="n5" value="&lt;b&gt;&lt;font color=&apos;#188038&apos;&gt;5 [stream]&lt;/font&gt;&lt;/b&gt;  CertEvent{type:ISSUED, cn:&quot;new-sensor-1&quot;, ou:&quot;sy&quot;, issued_at:…, expires_at:…}"
