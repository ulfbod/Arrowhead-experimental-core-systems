<mxfile host="Claude" modified="2026-06-15" type="device" version="21.0.0">
<!-- Experiment 13 gRPC Signaling Diagrams — Authorization Stack
     Page 1: AuthorizationPDP.Decide   — canonical PDP-PEP, control-plane PEP
     Page 2: CertificateLifecycle.Subscribe — CA-to-PIP attribute provisioning (NOT a PDP-PEP interface)
     The attribute pipeline in Page 2 feeds the XACML subject attributes evaluated in Page 1. -->

  <!-- ═══════════════════════════════════════════════════════════════════════
       Page 1 — AuthorizationPDP.Decide  (arrowhead.authz.v1)
       DynamicOrchestration (PEP) → authz-pdp (PDP) → AuthzForce CE
       ═══════════════════════════════════════════════════════════════════════ -->
  <diagram id="authz-pdp-decide" name="AuthorizationPDP.Decide">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1"
                  tooltips="1" connect="0" arrows="1" fold="1" page="0"
                  pageScale="1" pageWidth="1200" pageHeight="900"
                  math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ── Title ──────────────────────────────────────────────────────── -->
        <mxCell id="t0" value="AuthorizationPDP.Decide — Unary gRPC · arrowhead.authz.v1"
                style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;fontColor=#174ea6;"
                vertex="1" parent="1">
          <mxGeometry x="20" y="16" width="700" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="t0b" value="DynamicOrchestration (PEP) calls authz-pdp (PDP) once per provider candidate. Only PERMIT providers are included in the orchestration result."
                style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;fontColor=#5f6368;"
                vertex="1" parent="1">
          <mxGeometry x="20" y="48" width="800" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t0c" value="&lt;b&gt;Canonical PDP–PEP with deviations:&lt;/b&gt; (1) control-plane PEP — discloses endpoints, does not block connections · (2) action=&quot;orchestrate&quot; is a namespace tag, not an operation verb · (3) provider is a first-class XACML attribute for per-provider IoT policies"
                style="text;html=1;strokeColor=#c6dafc;fillColor=#e8f0fe;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontColor=#174ea6;rounded=1;"
                vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="860" height="32" as="geometry"/>
        </mxCell>

        <!-- ── Participant headers ─────────────────────────────────────────── -->
        <!-- Consumer  center=115 -->
        <mxCell id="p1" value="&lt;b&gt;Consumer&lt;/b&gt;&lt;br/&gt;&lt;font style=&apos;font-size:10px;color:#5f6368;&apos;&gt;e.g. portal-cloud-ml&lt;/font&gt;"
