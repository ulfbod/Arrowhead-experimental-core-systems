                vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- ── Lifelines ───────────────────────────────────────────────────── -->
        <mxCell id="k1" value="" style="endArrow=none;dashed=1;strokeColor=#b0b8c1;strokeWidth=1.5;dashPattern=8 4;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="130" as="sourcePoint"/>
            <mxPoint x="110" y="900" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="k2" value="" style="endArrow=none;dashed=1;strokeColor=#b0b8c1;strokeWidth=1.5;dashPattern=8 4;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="130" as="sourcePoint"/>
            <mxPoint x="310" y="900" as="targetPoint"/>
