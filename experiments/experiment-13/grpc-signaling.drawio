  <!-- ═══════════════════════════════════════════════════════════════════════
       Page 2 — CertificateLifecycle.Subscribe  (arrowhead.ca.v1)
       profile-ca (server) → PIP (subscriber) → SubjectStore
       ═══════════════════════════════════════════════════════════════════════ -->
  <diagram id="cert-lifecycle-subscribe" name="CertificateLifecycle.Subscribe">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1"
                  tooltips="1" connect="0" arrows="1" fold="1" page="0"
                  pageScale="1" pageWidth="1100" pageHeight="900"
                  math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ── Title ──────────────────────────────────────────────────────── -->
        <mxCell id="t1" value="CertificateLifecycle.Subscribe — Server-streaming gRPC · arrowhead.ca.v1"
                style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;fontColor=#137333;"
                vertex="1" parent="1">
          <mxGeometry x="20" y="16" width="700" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="t1b" value="profile-ca streams certificate lifecycle events to PIP. PIP registers cert-level attributes into SubjectStore for downstream XACML enrichment."
                style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;fontColor=#5f6368;"
                vertex="1" parent="1">
          <mxGeometry x="20" y="48" width="800" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="t1c" value="&lt;b&gt;NOT a PDP–PEP interface.&lt;/b&gt; This is a CA-to-PIP attribute provisioning channel. Classic XACML has the PDP pull attributes from PIP synchronously; here the model is inverted — PIP subscribes (push). Authentication events (cert issued/revoked) are causally coupled to XACML authorization outcomes via cert-valid and cert-level subject attributes."
                style="text;html=1;strokeColor=#f5c6c4;fillColor=#fce8e6;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontColor=#a50000;rounded=1;"
                vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="840" height="32" as="geometry"/>
        </mxCell>

        <!-- ── Participant headers ─────────────────────────────────────────── -->
        <!-- Administrator  center=110 -->
        <mxCell id="q1" value="&lt;b&gt;Administrator&lt;/b&gt;&lt;br/&gt;&lt;font style=&apos;font-size:10px;color:#5f6368;&apos;&gt;or cert-provisioner&lt;/font&gt;"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9334e6;fontColor=#4a0072;fontSize=12;arcSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- profile-ca  center=310 -->
        <mxCell id="q2" value="&lt;b&gt;profile-ca&lt;/b&gt;&lt;br/&gt;&lt;font style=&apos;font-size:10px;color:#5f6368;&apos;&gt;CA + gRPC server :8089&lt;/font&gt;"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#188038;fontColor=#1a5c20;fontSize=12;arcSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="230" y="80" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- PIP  center=510 -->
        <mxCell id="q3" value="&lt;b&gt;PIP&lt;/b&gt;&lt;br/&gt;&lt;font style=&apos;font-size:10px;color:#5f6368;&apos;&gt;gRPC subscriber :9606&lt;/font&gt;"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1a73e8;fontColor=#174ea6;fontSize=12;arcSize=10;"
                vertex="1" parent="1">
          <mxGeometry x="430" y="80" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- SubjectStore  center=720 -->
        <mxCell id="q4" value="&lt;b&gt;SubjectStore&lt;/b&gt;&lt;br/&gt;&lt;font style=&apos;font-size:10px;color:#5f6368;&apos;&gt;in-memory cert cache&lt;/font&gt;"
