        <mxCell id="n6" value="&lt;b&gt;6&lt;/b&gt;  Register(&quot;new-sensor-1&quot;, &quot;sy&quot;, valid=true)"
                style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;fontSize=11;fontColor=#d79b00;"
