          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="130" as="sourcePoint"/>
            <mxPoint x="720" y="900" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ── Phase banner: Startup ───────────────────────────────────────── -->
        <mxCell id="ph1" value="STARTUP / FIRST CONNECT"
                style="text;html=1;strokeColor=#dadce0;fillColor=#f1f3f4;align=center;verticalAlign=middle;spacingLeft=4;fontSize=11;fontStyle=1;fontColor=#5f6368;"
                vertex="1" parent="1">
          <mxGeometry x="30" y="148" width="820" height="22" as="geometry"/>
        </mxCell>

        <!-- ── Message 1: PIP → profile-ca: Subscribe ─────────────────────── -->
        <mxCell id="n1" value="&lt;b&gt;&lt;font color=&apos;#1a73e8&apos;&gt;1 [gRPC stream open]  CertificateLifecycle.Subscribe&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&apos;color:#1a73e8;font-size:10px;&apos;&gt;{include_snapshot: true}&lt;/font&gt;"
                style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;fontSize=11;"
                vertex="1" connectable="0" parent="1">
          <mxGeometry x="410" y="190" relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="n1e" value="" style="endArrow=block;endFill=1;strokeColor=#1a73e8;strokeWidth=2.5;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="206" as="sourcePoint"/>
            <mxPoint x="310" y="206" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ── Phase banner: Snapshot ──────────────────────────────────────── -->
        <mxCell id="ph2" value="SNAPSHOT PHASE — existing certificates streamed before live events"
                style="text;html=1;strokeColor=#188038;fillColor=#d5e8d4;align=center;verticalAlign=middle;spacingLeft=4;fontSize=11;fontStyle=1;fontColor=#137333;"
                vertex="1" parent="1">
          <mxGeometry x="30" y="230" width="820" height="22" as="geometry"/>
        </mxCell>

        <!-- ── Message 2a: profile-ca → PIP: SNAPSHOT 1 ──────────────────── -->
        <mxCell id="n2a" value="&lt;b&gt;&lt;font color=&apos;#188038&apos;&gt;2a [stream]&lt;/font&gt;&lt;/b&gt;  CertEvent{type:SNAPSHOT, cn:&quot;robot-fleet-site-1&quot;, ou:&quot;sy&quot;, issued_at:…}"
