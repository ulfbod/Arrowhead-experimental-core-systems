                vertex="1" parent="1">
          <mxGeometry x="30" y="408" width="820" height="22" as="geometry"/>
        </mxCell>

        <!-- ── Message 4: Admin → profile-ca: issue cert ─────────────────── -->
        <mxCell id="n4" value="&lt;b&gt;4&lt;/b&gt;  POST /ca/certificates  (issue new certificate)"
