            <mxPoint x="720" y="706" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ── Phase banner: Reconnect ─────────────────────────────────────── -->
        <mxCell id="ph4" value="RECONNECT — on stream failure (exponential backoff 1 s → 30 s max; last known state retained)"
                style="text;html=1;strokeColor=#c5221f;fillColor=#fce8e6;align=center;verticalAlign=middle;spacingLeft=4;fontSize=11;fontStyle=1;fontColor=#c5221f;"
                vertex="1" parent="1">
          <mxGeometry x="30" y="736" width="820" height="22" as="geometry"/>
        </mxCell>

        <!-- ── Message 10: PIP → profile-ca: reconnect ──────────────────── -->
        <mxCell id="n10" value="&lt;b&gt;&lt;font color=&apos;#1a73e8&apos;&gt;10 [reconnect]  Subscribe({include_snapshot: true})&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&apos;color:#1a73e8;font-size:10px;&apos;&gt;retains last known state during outage (fail-safe, not fail-purge)&lt;/font&gt;"
                style="edgeLabel;html=1;align=center;verticalAlign=bottom;resizable=0;fontSize=11;"
