        <mxCell id="note3"
                value="&lt;b&gt;Cert level (ou) values:&lt;/b&gt;&lt;br/&gt;&quot;lo&quot; — Local Cloud CA (root)&lt;br/&gt;&quot;on&quot; — Onboarding&lt;br/&gt;&quot;de&quot; — Device&lt;br/&gt;&quot;sy&quot; — System ★ (service mTLS)"
                style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;size=14;"
