            <mxPoint x="510" y="660" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ── Message 9: PIP → SubjectStore: Register (revoked) ─────────── -->
        <mxCell id="n9" value="&lt;b&gt;9&lt;/b&gt;  Register(&quot;old-sensor&quot;, &quot;sy&quot;, valid=false)"
